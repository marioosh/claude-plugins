#!/bin/sh
# buggy-tag.sh – generated by the buggy plugin; regenerate with /buggy:doctor or /buggy:start.
# Tags versions after merges and commits on the main branch (D-3, D-28):
#   vX.Y.Z      when the version file in HEAD holds a version without a tag yet
#   buggy-init  once, on the first main-branch commit that contains .buggy/config.yaml
# Never pushes. Plain POSIX sh – no Node needed, works in every clone.
#
# buggy:config main={{main_branch}} file={{version_file}} key={{version_key}}

MAIN='{{main_branch}}'
VERSION_FILE='{{version_file}}'
VERSION_KEY='{{version_key}}'

read_version() {
  content=$(git show "HEAD:$VERSION_FILE" 2>/dev/null) || return 1
  if [ -n "$VERSION_KEY" ]; then
    printf '%s\n' "$content" | sed -n "s/.*\"$VERSION_KEY\"[[:space:]]*:[[:space:]]*\"\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)\".*/\1/p" | head -n 1
  else
    printf '%s' "$content" | tr -d '[:space:]'
  fi
}

if [ "$1" = "--print-version" ]; then
  read_version
  exit 0
fi

branch=$(git symbolic-ref --short -q HEAD) || exit 0
[ "$branch" = "$MAIN" ] || exit 0

v=$(read_version) || v=''
if [ -n "$v" ] && [ "$v" != "0.0.0" ]; then
  if printf '%s' "$v" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
    tag="v$v"
    if existing=$(git rev-parse -q --verify "refs/tags/$tag^{commit}"); then
      if ! git merge-base --is-ancestor "$existing" HEAD; then
        echo "buggy: tag $tag already exists on $(git rev-parse --short "$existing"), which is not in the history of $MAIN. Not changed – run /buggy:doctor." >&2
      fi
    else
      pattern="^releases/$(printf '%s' "$v" | sed 's/\./\\./g')-[^/]*/release-note\.md\$"
      note=$(git ls-tree -r --name-only HEAD -- releases/ 2>/dev/null | grep -E "$pattern" | head -n 1)
      msg="Version $v"
      if [ -n "$note" ]; then
        msg=$(git show "HEAD:$note" | head -n 1 | sed 's/^#[[:space:]]*//')
      fi
      git tag -a "$tag" -m "$msg" && echo "buggy: created tag $tag – push it with: git push --follow-tags"
    fi
  else
    echo "buggy: $VERSION_FILE does not hold a version X.Y.Z ('$v'); no tag created." >&2
  fi
fi

if ! git rev-parse -q --verify refs/tags/buggy-init >/dev/null; then
  if git cat-file -e HEAD:.buggy/config.yaml 2>/dev/null; then
    git tag -a buggy-init -m "buggy initialized" && echo "buggy: created tag buggy-init"
  fi
fi
exit 0
